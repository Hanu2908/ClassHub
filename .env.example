# Supabase — populate these from your Supabase project dashboard
# Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Settings → API → Project API Keys → anon (public)
# Use the anon (public) key for client builds only. Do NOT commit
# production secrets to the repository. Replace the value below.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: enable demo mode for local development only
# Set to "true" in .env for quick demos; gated behind import.meta.env.DEV
VITE_ENABLE_DEMO=false

# Web Push — VAPID public key (generate with: npx web-push generate-vapid-keys)
# The private key goes in Supabase Edge Function secrets, NOT here.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
